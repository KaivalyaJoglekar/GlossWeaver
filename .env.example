# API defaults: one resident model, lazy loading, no implicit downloads.
GLOSSWEAVER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HF_HUB_OFFLINE=1
TOKENIZERS_PARALLELISM=false
# Optional root override for CLI and external checkpoint mounts:
# GLOSSWEAVER_ROOT=/absolute/path/to/GlossWeaver
